# Port HTTP du serveur
PORT=3000

# URL publique HTTPS de votre serveur (ex. https://ainai.onrender.com).
# Nécessaire pour le webhook Facebook et la connexion « Se connecter avec Facebook ».
PUBLIC_URL=

# Mot de passe du tableau de bord (obligatoire en production)
ADMIN_PASSWORD=changez-moi

# Clé secrète pour chiffrer les clés API et signer les sessions.
# Générez-en une avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET_KEY=

# Dossier où sont stockées les données (fichier JSON)
DATA_DIR=./data

# Version de l'API Graph de Facebook
GRAPH_VERSION=v23.0

# --- Hébergement gratuit sans disque (Render gratuit, Koyeb…) ---
# Choisissez UNE base de données gratuite (la table est créée automatiquement, sauf Supabase) :
#   MongoDB Atlas : DATABASE_URL=mongodb+srv://utilisateur:motdepasse@cluster0.xxxx.mongodb.net/
#   Neon (Postgres) ou tout Postgres : DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require
DATABASE_URL=
#   Upstash Redis :
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
#   Supabase (exécutez d'abord supabase.sql) :
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Le serveur se rend visite toutes les 10 min pour ne pas être endormi (true/false)
KEEP_ALIVE=true
